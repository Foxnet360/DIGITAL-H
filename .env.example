# ==========================================
# DATABASE CONFIGURATION (Hostinger MySQL)
# Used by: PHP API (mysqli + PDO), unified nurturing adapter.
# ==========================================
DB_HOST=localhost
DB_USER=your_db_user
DB_PASS=your_db_password
DB_NAME=your_db_name

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3000
NODE_ENV=production

# ==========================================
# FRONTEND URL
# ==========================================
FRONTEND_URL=http://localhost:3000

# ==========================================
# EMAIL - Hostinger SMTP
# Used by: legacy thank-you email and unified Email 1.
# ==========================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM=DIGITAL-H <your_email@yourdomain.com>

# ==========================================
# UNIFIED NURTURING (acrux.life)
# No extra variables are required; the adapter reuses DB_* and SMTP_* above.
# Ensure the target database contains the `nurturing_sequences` table.

# ==========================================
# GEMINI API KEY (Optional)
# ==========================================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ==========================================
# SENTRY CONFIGURATION
# ==========================================
VITE_SENTRY_DSN=
